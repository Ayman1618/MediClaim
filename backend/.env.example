# ──────────────────────────────────────────────
# MediClaim Backend — Environment Configuration
# ──────────────────────────────────────────────
# Copy this file to .env and fill in real values.
# Never commit .env to version control.

# Server
PORT=3000

# MongoDB
MONGODB_URI=mongodb://localhost:27017/mediclaim

# JWT
# Use a strong random secret in production: openssl rand -hex 64
JWT_SECRET=change_me_to_a_secure_random_secret
JWT_EXPIRES_IN=7d

# File storage
# Absolute or relative path for uploaded documents.
# If relative, it is resolved from the backend project root.
UPLOAD_DIRECTORY=./uploads
